# Meta Model API secret: server only, never a Unity asset.
MODEL_API_KEY=
NPC_MODEL_REASONING=minimal
HOST=127.0.0.1
PORT=8787
# Local Editor and Quest USB Development Builds. LAN/release builds require meta.
AUTH_MODE=local
LOCAL_ACCESS_TOKEN=
# Required for AUTH_MODE=meta; distinct from the Model API key.
META_APP_ID=
META_APP_SECRET=

# Local PostgreSQL 17 (choose a URL-safe password; never commit .env)
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql://villagerai:replace-with-random-password@127.0.0.1:54329/villagerai
