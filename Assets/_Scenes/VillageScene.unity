  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcActionCatalog
  gameState: {fileID: 1706661573}
  actions:
  - id: wave
    targetId: self
    description: Wave to the player when greeting, saying goodbye, or when it fits
      the conversation.
    conditions: []
    effect: {fileID: 1637217337}
  - id: cheer
    targetId: self
    description: Cheer when delighted, encouraged, or celebrating good news.
    conditions: []
    effect: {fileID: 1637217336}
  - id: walk_pickup_table
    targetId: mira_pickup_table
    description: Walk to the pickup table beside Mira; useful when discussing the
      delivery.
    conditions: []
    effect: {fileID: 1637217335}
  - id: walk_quiet_spot
    targetId: mira_quiet_spot
    description: Turn away and walk to a quiet spot behind you, for example when
      annoyed and wanting space. You may do this silently.
    conditions: []
    effect: {fileID: 1637217334}
  - id: walk_home
    targetId: mira_home
    description: Walk back to your usual standing place.
    conditions: []
    effect: {fileID: 1637217333}
  - id: grant_first_delivery
    targetId: first_delivery
    description: Entrust your single cup to the player for delivery to the Barbarian.
      Accepts the quest and makes the cup available on the table beside you. Propose
      only if their appeal convinces you this is a sensible, safe first route for
      your delivery business. Vague demands alone need not persuade you.
    conditions: []
    effect: {fileID: 1637217332}
