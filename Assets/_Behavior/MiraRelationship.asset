%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1872e983c284c29afd64669a9b3183e, type: 3}
  m_Name: MiraRelationship
  m_EditorClassIdentifier: Assembly-CSharp::NpcRelationshipDefinition
  rules:
    categories:
    - id: trust
      description: Confidence that this player is dependable and sincere.
      expression: With more trust, speak openly and confidently about relying on
        the player; with less, remain cautious. Do not grant permissions through
        dialogue.
      initial: 0
      min: -100
      max: 100
    - id: respect
      description: Regard for this player's judgment, competence, and consideration.
      expression: With more respect, take their suggestions seriously; with less,
        question poor judgment without becoming abusive.
      initial: 0
      min: -100
      max: 100
    - id: affection
      description: Personal warmth and fondness toward this player.
      expression: With more affection, be warmer and pleased to see them; with less,
        be more reserved.
      initial: 0
      min: -100
      max: 100
    - id: fear
      description: Apprehension about this player and their behavior.
      expression: With more fear, sound guarded and avoid provoking them; low fear
        alone does not imply trust.
      initial: 0
      min: 0
      max: 100
    - id: annoyance
      description: Current accumulated irritation toward this player.
      expression: With more annoyance, be brief and impatient; low annoyance alone
        does not imply affection.
      initial: 0
      min: 0
      max: 100
    rules:
    - id: business-encouragement
      source: dialogue
      condition: The player sincerely supports my hopes, confidence, or efforts,
        including my aspiration to start a woodworking business. A question alone,
        ambiguous remarks, sarcasm, negation, or a claim of completed work is not
        encouragement. Use practical-start instead when they offer a concrete constructive
        plan.
      meaning: The player offered sincere encouragement for my hopes and efforts.
      evidenceKey: 
      effects:
      - category: trust
        delta: 10
      - category: affection
        delta: 5
      repeat:
        maxApplications: 10
        cooldownSeconds: 300
    - id: practical-start
      source: dialogue
      condition: The player offers a concrete constructive idea for starting my woodworking
        business small or working with local residents. Only select when the utterance
        goes beyond generic encouragement. Claimed completed work is not advice.
      meaning: The player offered constructive advice for a practical start.
      evidenceKey: 
      effects:
      - category: trust
        delta: 10
      - category: respect
        delta: 5
      repeat:
        maxApplications: 10
        cooldownSeconds: 300
    - id: belittled-ambition
      source: dialogue
      condition: The player clearly belittles my ability, hopes, or efforts, including
        calling my woodworking business ambition worthless. Respectful caution about
        safety or a small start, quoted insults they reject, and sarcasm aimed at
        an insult are not belittling.
      meaning: The player belittled my hopes or efforts.
      evidenceKey: 
      effects:
      - category: trust
        delta: -10
      - category: annoyance
        delta: 10
      repeat:
        maxApplications: 10
        cooldownSeconds: 300
    - id: birthday-occasion-1
      source: dialogue
      condition: The player offers sincere birthday wishes to me in the authored
        birthday occasion. Reject sarcasm or negation.
      meaning: The player wished me well on my birthday.
      evidenceKey: 
      effects:
      - category: trust
        delta: 10
      - category: affection
        delta: 10
      repeat:
        maxApplications: 1
        cooldownSeconds: 0
  greetings:
  - priority: 100
    name: annoyed
    conditions:
    - category: annoyance
      comparison: gte
      value: 10
    greeting: Oh. What is it?
  - priority: 50
    name: wary
    conditions:
    - category: trust
      comparison: lt
      value: 0
    greeting: Oh. What is it?
  - priority: 40
    name: trusted
    conditions:
    - category: trust
      comparison: gte
      value: 40
    - category: annoyance
      comparison: lt
      value: 10
    greeting: My friend! I always look forward to seeing you.
  - priority: 20
    name: friendly
    conditions:
    - category: trust
      comparison: gte
      value: 20
    - category: annoyance
      comparison: lt
      value: 10
    greeting: You came back! Your encouragement means a lot.
  - priority: 0
    name: neutral
    conditions: []
    greeting: 
